      ]
    },
    {
      "key": "forget_session",
      "label": {
        "en": "Forget the session",
        "fr": "Oublier la session",
        "de": "Sitzung vergessen",
        "es": "Olvidar la sesión"
      },
      "timeout_seconds": 30
    }
