{
  "manifest_version": 1,
  "type": "device",
  "name": "Verisure",
  "description": {
    "en": "Arm, disarm and follow your Verisure alarm, its detectors and sensors from Gladys.",
    "fr": "Armez, désarmez et suivez votre alarme Verisure, ses détecteurs et capteurs depuis Gladys."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/prohand/gladys-verisure:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-verisure/main/cover.png",
  "categories": ["security"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Use the login of your Verisure app. Two Verisure clouds exist: \"My Verisure\" (France, Spain, Italy, Portugal, United Kingdom, Ireland, Latin America) and \"Verisure\" (Nordics, Benelux, Germany...). The first connection asks for a code sent by SMS or e-mail: save, click \"Send a code\", then type it in \"Validate the code\".",
        "fr": "Utilisez l'identifiant de votre application Verisure. Il existe deux clouds Verisure : « My Verisure » (France, Espagne, Italie, Portugal, Royaume-Uni, Irlande, Amérique latine) et « Verisure » (pays nordiques, Benelux, Allemagne…). La première connexion demande un code envoyé par SMS ou e-mail : enregistrez, cliquez sur « Envoyer un code », puis saisissez-le dans « Valider le code »."
      },
      "links": [
        {
          "url": "https://customers.securitasdirect.fr",
          "label": {
            "en": "My Verisure (France)",
            "fr": "My Verisure (France)"
          }
        },
        {
          "url": "https://mypages.verisure.com",
          "label": {
            "en": "Verisure My Pages",
            "fr": "Verisure My Pages"
          }
        }
      ]
    },
    {
      "key": "platform",
      "type": "select",
      "label": {
        "en": "Verisure app",
        "fr": "Application Verisure"
      },
      "description": {
        "en": "The app you use to drive your alarm.",
        "fr": "L'application qui pilote votre alarme."
      },
      "required": true,
      "default": "owa",
      "options": [
        {
          "value": "owa",
          "label": {
            "en": "My Verisure (FR, ES, IT, PT, UK, IE, Latin America)",
            "fr": "My Verisure (FR, ES, IT, PT, UK, IE, Amérique latine)"
          }
        },
        {
          "value": "mypages",
          "label": {
            "en": "Verisure (Nordics, Benelux, Germany...)",
            "fr": "Verisure (pays nordiques, Benelux, Allemagne…)"
          }
        }
      ]
    },
    {
      "key": "country",
      "type": "select",
      "label": {
        "en": "Country (My Verisure)",
        "fr": "Pays (My Verisure)"
      },
      "description": {
        "en": "Country of your contract. Only used by the My Verisure app.",
        "fr": "Pays de votre contrat. Utilisé seulement par l'application My Verisure."
      },
      "required": false,
      "default": "FR",
      "options": [
        {
          "value": "FR",
          "label": {
            "en": "France",
            "fr": "France"
          }
        },
        {
          "value": "ES",
          "label": {
            "en": "Spain",
            "fr": "Espagne"
          }
        },
        {
          "value": "IT",
          "label": {
            "en": "Italy",
            "fr": "Italie"
          }
        },
        {
          "value": "PT",
          "label": {
            "en": "Portugal",
            "fr": "Portugal"
          }
        },
        {
          "value": "GB",
          "label": {
            "en": "United Kingdom",
            "fr": "Royaume-Uni"
          }
        },
        {
          "value": "IE",
          "label": {
            "en": "Ireland",
            "fr": "Irlande"
          }
        },
        {
          "value": "AR",
          "label": {
            "en": "Argentina",
            "fr": "Argentine"
          }
        },
        {
          "value": "BR",
          "label": {
            "en": "Brazil",
            "fr": "Brésil"
          }
        },
        {
          "value": "CL",
          "label": {
            "en": "Chile",
            "fr": "Chili"
          }
        },
        {
          "value": "PE",
          "label": {
            "en": "Peru",
            "fr": "Pérou"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Identifiant"
      },
      "description": {
        "en": "The login of your Verisure app (e-mail or customer number).",
        "fr": "L'identifiant de votre application Verisure (e-mail ou numéro client)."
      },
      "placeholder": {
        "en": "e.g. john@example.com",
        "fr": "ex. jean@exemple.fr"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "required": true
    },
    {
      "key": "alarm_code",
      "type": "secret",
      "label": {
        "en": "Alarm code",
        "fr": "Code de l'alarme"
      },
      "description": {
        "en": "Verisure app only: the code that arms and disarms the alarm and drives the locks. My Verisure does not need it.",
        "fr": "Application Verisure seulement : le code qui arme et désarme l'alarme et pilote les serrures. My Verisure n'en a pas besoin."
      },
      "required": false
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often Verisure is read, in seconds. Verisure blocks accounts that ask too often: keep 120 or more.",
        "fr": "Fréquence de lecture de Verisure, en secondes. Verisure bloque les comptes trop bavards : gardez 120 ou plus."
      },
      "required": false,
      "default": 120,
      "min": 60,
      "max": 3600
    },
    {
      "key": "debug_logs",
      "type": "boolean",
      "label": {
        "en": "Detailed logs",
        "fr": "Logs détaillés"
      },
      "description": {
        "en": "Log every exchange with Verisure (no password, no token), to diagnose a problem.",
        "fr": "Journalise chaque échange avec Verisure (sans mot de passe ni jeton), pour diagnostiquer un problème."
      },
      "required": false,
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 60
    },
    {
      "key": "send_code",
      "label": {
        "en": "Send a code",
        "fr": "Envoyer un code"
      },
      "timeout_seconds": 30
    },
    {
      "key": "validate_code",
      "label": {
        "en": "Validate the code",
        "fr": "Valider le code"
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "code",
          "type": "string",
          "label": {
            "en": "Code received",
            "fr": "Code reçu"
          },
          "placeholder": {
            "en": "e.g. 123456",
            "fr": "ex. 123456"
          },
          "required": true
        }
      ]
    },
    {
      "key": "forget_session",
      "label": {
        "en": "Forget the session",
        "fr": "Oublier la session"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "alarm_mode_changed",
      "label": {
        "en": "Verisure alarm mode changed",
        "fr": "Le mode de l'alarme Verisure a changé"
      },
      "description": {
        "en": "Armed or disarmed from the keypad, a badge, the app or a remote. Gladys's own orders never fire it.",
        "fr": "Armée ou désarmée au clavier, au badge, par l'application ou une télécommande. Les ordres de Gladys ne le déclenchent jamais."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Alarm",
            "fr": "Alarme"
          },
          "required": false
        },
        {
          "key": "mode",
          "type": "multi_select",
          "label": {
            "en": "New mode",
            "fr": "Nouveau mode"
          },
          "options": [
            {
              "value": "disarmed",
              "label": {
                "en": "Disarmed",
                "fr": "Désarmée"
              }
            },
            {
              "value": "armed_home",
              "label": {
                "en": "Partial (day)",
                "fr": "Partielle (jour)"
              }
            },
            {
              "value": "armed_night",
              "label": {
                "en": "Partial (night)",
                "fr": "Partielle (nuit)"
              }
            },
            {
              "value": "armed_away",
              "label": {
                "en": "Total",
                "fr": "Totale"
              }
            },
            {
              "value": "perimeter",
              "label": {
                "en": "Perimeter only",
                "fr": "Périmétrique seule"
              }
            },
            {
              "value": "armed_home_perimeter",
              "label": {
                "en": "Partial (day) + perimeter",
                "fr": "Partielle (jour) + périm."
              }
            },
            {
              "value": "armed_night_perimeter",
              "label": {
                "en": "Partial (night) + perimeter",
                "fr": "Partielle (nuit) + périm."
              }
            },
            {
              "value": "armed_away_perimeter",
              "label": {
                "en": "Total + perimeter",
                "fr": "Totale + périmétrique"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "New mode",
            "fr": "Nouveau mode"
          }
        },
        {
          "key": "previous_mode",
          "type": "string",
          "label": {
            "en": "Previous mode",
            "fr": "Mode précédent"
          }
        },
        {
          "key": "changed_by",
          "type": "string",
          "label": {
            "en": "Changed by",
            "fr": "Changé par"
          }
        }
      ]
    },
    {
      "key": "door_window_changed",
      "label": {
        "en": "A Verisure door/window detector moved",
        "fr": "Un détecteur d'ouverture Verisure a bougé"
      },
      "description": {
        "en": "A door or a window watched by Verisure opened or closed (Verisure app).",
        "fr": "Une porte ou une fenêtre surveillée par Verisure s'est ouverte ou fermée (application Verisure)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Detector",
            "fr": "Détecteur"
          },
          "required": false
        },
        {
          "key": "state",
          "type": "multi_select",
          "label": {
            "en": "State",
            "fr": "État"
          },
          "options": [
            {
              "value": "open",
              "label": {
                "en": "Opened",
                "fr": "Ouverte"
              }
            },
            {
              "value": "closed",
              "label": {
                "en": "Closed",
                "fr": "Fermée"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "state",
          "type": "string",
          "label": {
            "en": "State",
            "fr": "État"
          }
        },
        {
          "key": "device_name",
          "type": "string",
          "label": {
            "en": "Detector name",
            "fr": "Nom du détecteur"
          }
        }
      ]
    },
    {
      "key": "connection_lost",
      "label": {
        "en": "The Verisure connection is lost",
        "fr": "La connexion à Verisure est perdue"
      },
      "description": {
        "en": "Verisure stopped answering, refused the login or asks for a new verification code.",
        "fr": "Verisure ne répond plus, refuse la connexion ou demande un nouveau code de vérification."
      },
      "fields": [
        {
          "key": "reason",
          "type": "multi_select",
          "label": {
            "en": "Reason",
            "fr": "Raison"
          },
          "options": [
            {
              "value": "mfa_required",
              "label": {
                "en": "Code required",
                "fr": "Code requis"
              }
            },
            {
              "value": "auth_failed",
              "label": {
                "en": "Login refused",
                "fr": "Connexion refusée"
              }
            },
            {
              "value": "rate_limited",
              "label": {
                "en": "Too many requests",
                "fr": "Trop de requêtes"
              }
            },
            {
              "value": "unreachable",
              "label": {
                "en": "Cloud unreachable",
                "fr": "Cloud injoignable"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason",
            "fr": "Raison"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "set_alarm_mode",
      "label": {
        "en": "Set the Verisure alarm mode",
        "fr": "Changer le mode de l'alarme Verisure"
      },
      "description": {
        "en": "Arm or disarm the alarm. A refusal (door left open) is an output, not a failure.",
        "fr": "Arme ou désarme l'alarme. Un refus (porte restée ouverte) est un résultat, pas un échec."
      },
      "timeout_seconds": 120,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Alarm (empty: the only one)",
            "fr": "Alarme (vide : la seule du compte)"
          },
          "required": false
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "Mode",
            "fr": "Mode"
          },
          "required": true,
          "options": [
            {
              "value": "disarmed",
              "label": {
                "en": "Disarmed",
                "fr": "Désarmée"
              }
            },
            {
              "value": "armed_home",
              "label": {
                "en": "Partial (day)",
                "fr": "Partielle (jour)"
              }
            },
            {
              "value": "armed_night",
              "label": {
                "en": "Partial (night)",
                "fr": "Partielle (nuit)"
              }
            },
            {
              "value": "armed_away",
              "label": {
                "en": "Total",
                "fr": "Totale"
              }
            },
            {
              "value": "perimeter",
              "label": {
                "en": "Perimeter only",
                "fr": "Périmétrique seule"
              }
            },
            {
              "value": "armed_home_perimeter",
              "label": {
                "en": "Partial (day) + perimeter",
                "fr": "Partielle (jour) + périm."
              }
            },
            {
              "value": "armed_night_perimeter",
              "label": {
                "en": "Partial (night) + perimeter",
                "fr": "Partielle (nuit) + périm."
              }
            },
            {
              "value": "armed_away_perimeter",
              "label": {
                "en": "Total + perimeter",
                "fr": "Totale + périmétrique"
              }
            }
          ]
        },
        {
          "key": "force",
          "type": "boolean",
          "label": {
            "en": "Arm even with a door or window open",
            "fr": "Armer même avec une porte ou fenêtre ouverte"
          },
          "required": false,
          "default": false
        }
      ],
      "outputs": [
        {
          "key": "success",
          "type": "boolean",
          "label": {
            "en": "Done",
            "fr": "Effectué"
          }
        },
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "Alarm mode",
            "fr": "Mode de l'alarme"
          }
        },
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason of a refusal",
            "fr": "Raison d'un refus"
          }
        }
      ]
    },
    {
      "key": "refresh_alarm",
      "label": {
        "en": "Read the Verisure alarm now",
        "fr": "Lire l'alarme Verisure maintenant"
      },
      "description": {
        "en": "Ask the alarm its real state instead of waiting for the next refresh.",
        "fr": "Demande son état réel à l'alarme au lieu d'attendre le prochain rafraîchissement."
      },
      "timeout_seconds": 120,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Alarm (empty: the only one)",
            "fr": "Alarme (vide : la seule du compte)"
          },
          "required": false
        }
      ],
      "outputs": [
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "Alarm mode",
            "fr": "Mode de l'alarme"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "alarm",
      "label": {
        "en": "Verisure alarm",
        "fr": "Alarme Verisure"
      },
      "description": {
        "en": "Alarm mode, last change, open doors and windows, buttons to arm.",
        "fr": "Mode de l'alarme, dernier changement, ouvrants ouverts, boutons pour armer."
      },
      "icon": "shield",
      "action_timeout_seconds": 120,
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Alarm (empty: the only one)",
            "fr": "Alarme (vide : la seule du compte)"
          },
          "required": false
        },
        {
          "key": "allow_disarm",
          "type": "boolean",
          "label": {
            "en": "Show a Disarm button (anyone seeing the dashboard can use it)",
            "fr": "Afficher un bouton Désarmer (toute personne voyant le tableau de bord peut l'utiliser)"
          },
          "required": false,
          "default": false
        }
      ]
    }
  ]
}
