    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Identifiant",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "The login of your Verisure app (e-mail or customer number).",
        "fr": "L'identifiant de votre application Verisure (e-mail ou numéro client).",
        "de": "Der Benutzername deiner Verisure-App (E-Mail oder Kundennummer).",
        "es": "El usuario de su aplicación Verisure (correo electrónico o número de cliente)."
      },
      "placeholder": {
        "en": "e.g. john@example.com",
        "fr": "ex. jean@exemple.fr",
        "de": "z. B. max@beispiel.de",
        "es": "p. ej. juan@ejemplo.es"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "alarm_code",
      "type": "secret",
      "label": {
        "en": "Alarm code",
        "fr": "Code de l'alarme",
        "de": "Alarmcode",
        "es": "Código de la alarma"
      },
      "description": {
        "en": "Verisure app only: the code that arms and disarms the alarm and drives the locks. My Verisure does not need it.",
        "fr": "Application Verisure seulement : le code qui arme et désarme l'alarme et pilote les serrures. My Verisure n'en a pas besoin.",
        "de": "Nur Verisure-App: der Code, der die Alarmanlage scharf und unscharf schaltet und die Schlösser steuert. My Verisure benötigt ihn nicht.",
        "es": "Solo aplicación Verisure: el código que conecta y desconecta la alarma y controla las cerraduras. My Verisure no lo necesita."
      },
      "required": false
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often Verisure is read, in seconds. Verisure blocks accounts that ask too often: keep 120 or more.",
        "fr": "Fréquence de lecture de Verisure, en secondes. Verisure bloque les comptes trop bavards : gardez 120 ou plus.",
        "de": "Wie oft Verisure abgefragt wird, in Sekunden. Verisure sperrt Konten, die zu oft anfragen: Behalte 120 oder mehr bei.",
        "es": "Frecuencia de lectura de Verisure, en segundos. Verisure bloquea las cuentas que consultan demasiado: mantenga 120 o más."
      },
      "required": false,
      "default": 120,
      "min": 60,
      "max": 3600
    },
    {
      "key": "debug_logs",
      "type": "boolean",
      "label": {
        "en": "Detailed logs",
        "fr": "Logs détaillés",
        "de": "Detaillierte Logs",
        "es": "Registros detallados"
      },
      "description": {
        "en": "Log every exchange with Verisure (no password, no token), to diagnose a problem.",
        "fr": "Journalise chaque échange avec Verisure (sans mot de passe ni jeton), pour diagnostiquer un problème.",
        "de": "Protokolliert jeden Austausch mit Verisure (ohne Passwort und Token), um ein Problem zu diagnostizieren.",
        "es": "Registra cada intercambio con Verisure (sin contraseña ni token), para diagnosticar un problema."
      },
      "required": false,
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
